    <worksheet name='On-Time vs Delayed Deliveries'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_orders_dataset' name='federated.1wtvi7c1wn5y1n117w8sp1t9ivwu' />
          </datasources>
          <datasource-dependencies datasource='federated.1wtvi7c1wn5y1n117w8sp1t9ivwu'>
            <column caption='Delivery Performance' datatype='string' name='[Calculation_0169939892563972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot; THEN&#13;&#10;&#13;&#10;    IF ISNULL([order_delivered_customer_date (orders_dataset_cleaned_2.csv)])&#13;&#10;       OR ISNULL([order_estimated_delivery_date (orders_dataset_cleaned_2.csv)]) THEN&#13;&#10;        &quot;Missing Date&quot;&#13;&#10;&#13;&#10;    ELSEIF [order_delivered_customer_date (orders_dataset_cleaned_2.csv)]&#13;&#10;       &lt;= [order_estimated_delivery_date (orders_dataset_cleaned_2.csv)] THEN&#13;&#10;        &quot;On Time&quot;&#13;&#10;&#13;&#10;    ELSE&#13;&#10;        &quot;Delayed&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;END' />
            </column>
            <column-instance column='[order_id (orders_dataset_cleaned_2.csv)]' derivation='CountD' name='[ctd:order_id (orders_dataset_cleaned_2.csv):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0169939892563972]' derivation='None' name='[none:Calculation_0169939892563972:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date (Orders Dataset Cleaned 2.Csv)' datatype='datetime' name='[order_delivered_customer_date (orders_dataset_cleaned_2.csv)]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date (Orders Dataset Cleaned 2.Csv)' datatype='datetime' name='[order_estimated_delivery_date (orders_dataset_cleaned_2.csv)]' role='dimension' type='ordinal' />
            <column caption='Order Id (Orders Dataset Cleaned 2.Csv)' datatype='string' name='[order_id (orders_dataset_cleaned_2.csv)]' role='dimension' type='nominal' />
            <column caption='Order Status (Orders Dataset Cleaned 2.Csv)' datatype='string' name='[order_status (orders_dataset_cleaned_2.csv)]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.1wtvi7c1wn5y1n117w8sp1t9ivwu].[none:Calculation_0169939892563972:nk]' direction='DESC' using='[federated.1wtvi7c1wn5y1n117w8sp1t9ivwu].[ctd:order_id (orders_dataset_cleaned_2.csv):qk]' />
