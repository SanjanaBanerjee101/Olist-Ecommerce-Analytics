      <aliases enabled='yes' />
      <column caption='Delivered Order ID' datatype='string' name='[Calculation_0169939862577152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot; THEN&#13;&#10;    [order_id (orders_dataset_cleaned_2.csv)]&#13;&#10;END' />
      </column>
      <column caption='Delivery Rate' datatype='real' name='[Calculation_0169939883147265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot;&#13;&#10;    THEN [order_id (orders_dataset_cleaned_2.csv)]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id (orders_dataset_cleaned_2.csv)])' />
      </column>
      <column caption='Cancelled Order ID' datatype='string' name='[Calculation_0169939884769282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;canceled&quot; THEN&#13;&#10;    [order_id (orders_dataset_cleaned_2.csv)]&#13;&#10;END' />
      </column>
      <column caption='Not Delivered Order ID' datatype='string' name='[Calculation_0169939885527043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] &lt;&gt; &quot;delivered&quot; THEN&#13;&#10;    [order_id (orders_dataset_cleaned_2.csv)]&#13;&#10;END' />
      </column>
      <column caption='Delivery Performance' datatype='string' name='[Calculation_0169939892563972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot; THEN&#13;&#10;&#13;&#10;    IF ISNULL([order_delivered_customer_date (orders_dataset_cleaned_2.csv)])&#13;&#10;       OR ISNULL([order_estimated_delivery_date (orders_dataset_cleaned_2.csv)]) THEN&#13;&#10;        &quot;Missing Date&quot;&#13;&#10;&#13;&#10;    ELSEIF [order_delivered_customer_date (orders_dataset_cleaned_2.csv)]&#13;&#10;       &lt;= [order_estimated_delivery_date (orders_dataset_cleaned_2.csv)] THEN&#13;&#10;        &quot;On Time&quot;&#13;&#10;&#13;&#10;    ELSE&#13;&#10;        &quot;Delayed&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Delivery Time (Days)' datatype='integer' name='[Calculation_0169939897315333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot;&#13;&#10;AND NOT ISNULL([order_delivered_customer_date (orders_dataset_cleaned_2.csv)])&#13;&#10;AND NOT ISNULL([order_purchase_timestamp (orders_dataset_cleaned_2.csv)])&#13;&#10;THEN&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [order_purchase_timestamp (orders_dataset_cleaned_2.csv)],&#13;&#10;        [order_delivered_customer_date (orders_dataset_cleaned_2.csv)]&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Non-Delivered Orders' datatype='string' name='[Calculation_0169939900530694]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] &lt;&gt; &quot;delivered&quot; THEN&#13;&#10;    [order_id (orders_dataset_cleaned_2.csv)]&#13;&#10;END' />
      </column>
