    <worksheet name='Average Delivery Time by Month'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_orders_dataset' name='federated.1wtvi7c1wn5y1n117w8sp1t9ivwu' />
          </datasources>
          <datasource-dependencies datasource='federated.1wtvi7c1wn5y1n117w8sp1t9ivwu'>
            <column caption='Delivery Time (Days)' datatype='integer' name='[Calculation_0169939897315333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_status (orders_dataset_cleaned_2.csv)] = &quot;delivered&quot;&#13;&#10;AND NOT ISNULL([order_delivered_customer_date (orders_dataset_cleaned_2.csv)])&#13;&#10;AND NOT ISNULL([order_purchase_timestamp (orders_dataset_cleaned_2.csv)])&#13;&#10;THEN&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [order_purchase_timestamp (orders_dataset_cleaned_2.csv)],&#13;&#10;        [order_delivered_customer_date (orders_dataset_cleaned_2.csv)]&#13;&#10;    )&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_0169939897315333]' derivation='Avg' name='[avg:Calculation_0169939897315333:qk]' pivot='key' type='quantitative' />
            <column caption='Order Delivered Customer Date (Orders Dataset Cleaned 2.Csv)' datatype='datetime' name='[order_delivered_customer_date (orders_dataset_cleaned_2.csv)]' role='dimension' type='ordinal' />
            <column caption='Order Purchase Timestamp (Orders Dataset Cleaned 2.Csv)' datatype='datetime' name='[order_purchase_timestamp (orders_dataset_cleaned_2.csv)]' role='dimension' type='ordinal' />
            <column caption='Order Status (Orders Dataset Cleaned 2.Csv)' datatype='string' name='[order_status (orders_dataset_cleaned_2.csv)]' role='dimension' type='nominal' />
            <column-instance column='[order_purchase_timestamp (orders_dataset_cleaned_2.csv)]' derivation='Month-Trunc' name='[tmn:order_purchase_timestamp (orders_dataset_cleaned_2.csv):qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.1wtvi7c1wn5y1n117w8sp1t9ivwu].[tmn:order_purchase_timestamp (orders_dataset_cleaned_2.csv):qk]' value='91' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-weight' field='[federated.1wtvi7c1wn5y1n117w8sp1t9ivwu].[avg:Calculation_0169939897315333:qk]' value='bold' />
